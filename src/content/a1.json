  "grammar": [
    {
      "unit": 1,
      "order": 1,
      "type": "text",
      "text_or_setswana": "In Setswana, how you greet and say goodbye depends on how many people you are speaking to.",
      "english": null
    },
    {
      "unit": 1,
      "order": 2,
      "type": "text",
      "text_or_setswana": "Talking to one person, use Dumela, O tsogile jang? and O kae?. Talking to two or more people, use Dumelang, Le tsogile jang? and Le kae?.",
      "english": null
    },
    {
      "unit": 1,
      "order": 3,
      "type": "text",
      "text_or_setswana": "Address people politely with rra (to one man) or mma (to one woman); for more than one, use borra or bomma.",
      "english": null
    },
    {
      "unit": 1,
      "order": 4,
      "type": "text",
      "text_or_setswana": "When you part, the word depends on who is leaving and who is staying: the one staying says Tsamaya sentle (\"go well\") to the one leaving, and the one leaving says Sala sentle (\"stay well\") back.",
      "english": null
    },
    {
      "unit": 1,
      "order": 5,
      "type": "text",
      "text_or_setswana": "Robala sentle (\"sleep well\") is used at night instead of Tsamaya sentle or Sala sentle.",
      "english": null
    },
    {
      "unit": 1,
      "order": 6,
      "type": "example",
      "text_or_setswana": "Dumela, rra.",
      "english": "Hello, sir."
    },
    {
      "unit": 1,
      "order": 7,
      "type": "example",
      "text_or_setswana": "Dumelang, bomma.",
      "english": "Hello, ladies."
    },
    {
      "unit": 1,
      "order": 8,
      "type": "example",
      "text_or_setswana": "O tsogile jang? Ke tsogile sentle.",
      "english": "How did you wake up? I woke up well."
    },
    {
      "unit": 1,
      "order": 9,
      "type": "example",
      "text_or_setswana": "Le kae? Re teng.",
      "english": "How are you (to several people)? We are fine."
    },
    {
      "unit": 1,
      "order": 10,
      "type": "example",
      "text_or_setswana": "Tsamaya sentle. Sala sentle.",
      "english": "Go well. Stay well."
    }
  ],
