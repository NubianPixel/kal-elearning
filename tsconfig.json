{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"]
  },
  // Replicates expo/tsconfig.base.json's exclude list (config dir-relative)
  // plus metro.config.ts and scripts/ — build tooling, not app code, so the
  // type-check ignores them (they also need Node globals this project
  // doesn't compile with, and scripts/ uses explicit .ts import extensions
  // for Node's native type stripping, which this project's tsc config
  // doesn't allow).
  "exclude": ["node_modules", "metro.config.js", "metro.config.ts", "scripts", "android", "ios"]
}
